# 이 파일을 복사해서 server/.env 를 만든 뒤 값을 채워요.
# .env 는 git에 올라가지 않아요. 비밀번호는 메신저 등으로 따로 전달해요.
#
# Supabase 대시보드 → 위쪽 Connect → "Session pooler" 의 값을 써요.
# (직접 연결 주소는 IPv6 전용이라 Render나 일부 PC에서 연결되지 않을 수 있어요.)
DB_URL=jdbc:postgresql://<세션 풀러 host>:5432/postgres
DB_USERNAME=postgres.<프로젝트 ID>
DB_PASSWORD=

# 로그인 토큰(JWT)을 서명하는 비밀 값이에요. 32자 이상, 사람마다 달라도 돼요.
# 만들기: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# 메신저 요약 같은 값을 암호화해서 저장할 때 쓰는 키예요(AES-256-GCM, base64로 인코딩한 32바이트).
# 같은 DB를 쓰는 사람은 모두 같은 값을 써야 서로 저장한 값을 읽을 수 있어요. 한 번 정하면 바꾸지 않아요.
# 만들기: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# AI(Claude Haiku 5.5) 호출 키예요. 비워 두면 AI를 부르는 API가 502 AI_UNAVAILABLE을 돌려줘요.
# 키 없이 개발하려면 AI_PROVIDER=fake로 두세요(가짜 요약이 나와요). 실제 키는 Anthropic Console에서 만들어요.
ANTHROPIC_API_KEY=
AI_PROVIDER=anthropic

# 관리자 페이지(http://localhost:8080/admin) 비밀번호예요. 16자 이상이고, 비워 두면 관리자 페이지가 꺼져요(2026.11.25).
# 만들기: node -e "console.log(require('crypto').randomBytes(18).toString('base64url'))"
ADMIN_PASSWORD=

# true면 가짜 로그인(POST /auth/dev)이 켜져요(기본값 꺼짐). 로컬 개발에서는 true로 둬요.
# 배포 서버(Render)에서는 꺼요(2026.11.21, render.yaml). 레포가 공개라 켜 두면 누구나 시험 계정에 들어올 수 있어요.
DEV_LOGIN_ENABLED=true

# true면 서버가 켜질 때 새벽 삭제 작업(1년 만료 · 동의 철회 30일 폐기)을 한 번 더 돌려요(기본값 꺼짐).
# Render 무료 요금제가 잠들어 새벽 작업을 건너뛰는 것을 따라잡으려는 것이라 배포 서버에서만 true예요.
# JOBS_RUN_ON_STARTUP=false

# 소셜 로그인 서버 검증 설정이에요. 비워 두면 그 로그인 방식은 501(AUTH_PROVIDER_NOT_READY)이에요.
# 카카오: 카카오 개발자 콘솔의 앱 ID(숫자). 카카오 access token이 우리 앱에서 발급된 것인지 확인하는 데 써요.
#        콘솔에서 카카오 로그인을 켜고 "닉네임" 동의항목을 설정해요(이메일은 요청하지 않아요).
KAKAO_APP_ID=
# 구글: ID token의 대상(aud)으로 받아들일 클라이언트 ID 목록(쉼표로 구분). 앱의 구글 로그인이 웹 클라이언트 ID로
#      토큰을 만들면 웹 클라이언트 ID를, 플랫폼 ID(안드로이드 · iOS)로 만들면 그 ID도 함께 넣어요.
GOOGLE_CLIENT_IDS=
