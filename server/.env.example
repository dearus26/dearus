# 이 파일을 복사해서 server/.env 를 만든 뒤 값을 채워요.
# .env 는 git에 올라가지 않아요. 비밀번호는 메신저 등으로 따로 전달해요.
#
# Supabase 대시보드 → 위쪽 Connect → "Session pooler" 의 값을 써요.
# (직접 연결 주소는 IPv6 전용이라 Render나 일부 PC에서 연결되지 않을 수 있어요.)
DB_URL=jdbc:postgresql://<세션 풀러 host>:5432/postgres
DB_USERNAME=postgres.<프로젝트 ID>
DB_PASSWORD=

# 로그인 토큰(JWT)을 서명하는 비밀 값이에요. 32자 이상, 사람마다 달라도 돼요.
# 만들기: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# true면 가짜 로그인(POST /auth/dev)이 켜져요. 로컬 개발에서만 true로 두고,
# 배포 서버(Render)에서는 이 항목을 만들지 않아요(기본값 꺼짐).
DEV_LOGIN_ENABLED=true
