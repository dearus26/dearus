# 이 파일을 복사해서 app/.env 를 만든 뒤 값을 바꿔요. .env 는 git에 올라가지 않아요.
# 값을 바꾸면 개발 서버를 다시 켜야 반영돼요: npx expo start -c

# mock: 서버 없이 가짜 데이터로 동작해요(기본값). live: 아래 서버를 실제로 불러요.
EXPO_PUBLIC_API_MODE=mock

# live일 때 부를 서버 주소예요. 폰에서는 localhost가 PC가 아니라 폰 자신이라서 PC의 IP 주소를 써요.
# 예) 서버를 내 PC에서 켰고 PC의 IP가 192.168.0.10이면 http://192.168.0.10:8080
# (PC의 IP는 PowerShell에서 ipconfig 로 확인하고, 폰과 PC는 같은 Wi-Fi여야 해요.)
EXPO_PUBLIC_API_URL=http://192.168.0.10:8080
